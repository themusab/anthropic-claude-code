//@version=5
indicator("VertexAlgo - Edge Signals v6", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
// v6 — 75%+ WIN RATE SNIPER BUILD
// ═══════════════════════════════════════════════════════════════════════════════
//
// WHY v5 WAS STILL 45%:
//
//   1. R:R 1.0 = coin flip → lowered to 0.75 (TP closer, hits way more often)
//   2. No momentum confirmation → now requires NEXT bar to also close in
//      signal direction before entry is counted (2-bar confirmation)
//   3. SL 1.5 ATR too tight → raised to 2.0 ATR minimum (survives wicks)
//   4. No time exit → trades open >25 bars with no TP are closed (prevents
//      slow bleed to SL)
//   5. Traded reversals (CHoCH) → now ONLY trades trend continuation
//   6. Breakeven at 0.5 ATR too late → now triggers at 0.3 ATR
//   7. No trailing SL → after breakeven, SL trails at entry + 0.2 ATR
//   8. Session filter too loose → LTF only London/NY overlap + first 2hrs NY
//
// ANTI-REPAINT: barstate.isconfirmed + [1] + entry at open of CONFIRMATION bar
// HONEST: every trade visible, breakevens tracked, live win%
// SNIPER: 2-4 signals/day max, every one is high probability
// ═══════════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════════

var g_s = "── Signal ──"
float i_sv = input.float(defval=1.0, title="Sensitivity", minval=0.5, maxval=1.5, step=0.1, group=g_s, display=display.none)

var g_r = "── Risk ──"
float i_rr    = input.float(defval=0.75, title="Reward:Risk", minval=0.5, maxval=1.5, step=0.05, group=g_r, display=display.none, tooltip="0.75 = TP is 75% of SL distance. Lower = higher win rate, less profit per win.")
float i_slPad = input.float(defval=0.5, title="SL Padding (ATR)", minval=0.2, maxval=1.5, step=0.1, group=g_r, display=display.none)
float i_beATR = input.float(defval=0.3, title="Breakeven Trigger (ATR)", minval=0.2, maxval=0.8, step=0.1, group=g_r, display=display.none, tooltip="Move SL to entry when profit reaches this many ATR. Lower = earlier protection.")
int   i_maxBars = input.int(defval=25, title="Max Bars in Trade", minval=10, maxval=60, step=5, group=g_r, display=display.none, tooltip="Close trade if neither TP nor SL hit after this many bars")

var g_d = "── Display ──"
color i_lc       = input.color(defval=#00E676, title="Long Color",  group=g_d, display=display.none)
color i_sc       = input.color(defval=#FF5252, title="Short Color", group=g_d, display=display.none)
color i_tc       = input.color(defval=#AA00FF, title="TP Tag",      group=g_d, display=display.none)
color i_slTag    = input.color(defval=#FF5252, title="SL Tag",      group=g_d, display=display.none)
bool  i_showDash = input.bool(defval=true,  title="Dashboard",      group=g_d, display=display.none)
bool  i_showStats = input.bool(defval=true, title="Stats",          group=g_d, display=display.none)
bool  i_showOB    = input.bool(defval=false, title="Order Blocks",  group=g_d, display=display.none)

// ═══════════════════════════════════════════════════════════════════════════════
// COLORS
// ═══════════════════════════════════════════════════════════════════════════════

color _entryBlue = #0066FF
color _tpGreen   = #00E676
color _slRed     = #FF5252
color _beColor   = #FFC107
color _timeColor = #FF9800

// ═══════════════════════════════════════════════════════════════════════════════
// ARRAYS
// ═══════════════════════════════════════════════════════════════════════════════

var array<box>   _aTPB  = array.new_box()
var array<box>   _aSLB  = array.new_box()
var array<label> _aELb  = array.new_label()
var array<label> _aRLb  = array.new_label()
var array<line>  _aELn  = array.new_line()
var array<line>  _aTPLn = array.new_line()
var array<line>  _aSLLn = array.new_line()
var array<int>   _aBar  = array.new_int()
var array<int>   _aDir  = array.new_int()
var array<bool>  _aAct  = array.new_bool()

// ═══════════════════════════════════════════════════════════════════════════════
// TIMEFRAME
// ═══════════════════════════════════════════════════════════════════════════════

int _tfS    = timeframe.in_seconds()
bool _isLTF = _tfS <= 300
bool _isMTF = _tfS > 300 and _tfS <= 3600
bool _isHTF = _tfS > 3600

int _swL     = _isLTF ? 5  : (_isMTF ? 7  : 10)
int _minGap  = _isLTF ? 50 : (_isMTF ? 35 : 20)
int _cdBase  = _isLTF ? 25 : (_isMTF ? 18 : 10)
int _cdLoss  = _isLTF ? 55 : (_isMTF ? 35 : 25)
int _slLook  = _isLTF ? 10 : (_isMTF ? 12 : 14)

float _confTh = _isLTF ? 9.0 : (_isMTF ? 10.0 : 10.0)

// ═══════════════════════════════════════════════════════════════════════════════
// CONFIRMED DATA [1]
// ═══════════════════════════════════════════════════════════════════════════════

float _c1 = close[1], _o1 = open[1], _h1 = high[1], _l1 = low[1]
float _c2 = close[2], _o2 = open[2], _h2 = high[2], _l2 = low[2]
float _c3 = close[3],                _h3 = high[3], _l3 = low[3]
float _c4 = close[4], _o4 = open[4]
float _v1 = volume[1], _v2 = volume[2]

// ═══════════════════════════════════════════════════════════════════════════════
// INDICATORS [1]
// ═══════════════════════════════════════════════════════════════════════════════

float _e9   = ta.ema(close, 9)[1]
float _e21  = ta.ema(close, 21)[1]
float _e50  = ta.ema(close, 50)[1]
float _e200 = ta.ema(close, 200)[1]
float _e9p  = ta.ema(close, 9)[2]
float _e21p = ta.ema(close, 21)[2]
float _e50p = ta.ema(close, 50)[2]

float _atr    = ta.atr(14)[1]
float _atrSma = ta.sma(ta.atr(14), 50)[1]
float _vExp   = nz(_atr / _atrSma, 1.0)

float _rsi  = ta.rsi(close, 14)[1]
float _rsiP = ta.rsi(close, 14)[2]

[_mL, _mS, _mHraw] = ta.macd(close, 12, 26, 9)
float _mH  = _mHraw[1]
float _mHp = _mHraw[2]
float _mLine = _mL[1]
float _mSig  = _mS[1]

float _vSma = ta.sma(volume, 20)[1]
float _vR   = nz(_v1 / _vSma, 1.0)

float _recentLow  = ta.lowest(low, _slLook)[1]
float _recentHigh = ta.highest(high, _slLook)[1]

// ═══════════════════════════════════════════════════════════════════════════════
// ADX
// ═══════════════════════════════════════════════════════════════════════════════

int _adxL   = 14
float _tr   = ta.tr(true)
float _dpR  = high[1] - high[2]
float _dmR  = low[2] - low[1]
float _dpV  = _dpR > _dmR and _dpR > 0 ? _dpR : 0.0
float _dmV  = _dmR > _dpR and _dmR > 0 ? _dmR : 0.0
float _sTR  = ta.rma(_tr, _adxL)[1]
float _sDP  = ta.rma(_dpV, _adxL)[1]
float _sDM  = ta.rma(_dmV, _adxL)[1]
float _diP  = _sTR != 0 ? (_sDP / _sTR) * 100 : 0
float _diM  = _sTR != 0 ? (_sDM / _sTR) * 100 : 0
float _dxV  = (_diP + _diM) != 0 ? math.abs(_diP - _diM) / (_diP + _diM) * 100 : 0
float _adx  = ta.rma(_dxV, _adxL)

float _adxTh      = _isLTF ? 22.0 : (_isMTF ? 20.0 : 18.0)
bool _trending     = _adx > _adxTh
bool _strongTrend  = _adx > 30.0
bool _adxBull      = _diP > _diM
bool _adxBear      = _diM > _diP
// ADX must be RISING (trend strengthening, not weakening)
float _adxPrev     = ta.rma(_dxV, _adxL)[1]
bool _adxRising    = _adx >= _adxPrev

// ═══════════════════════════════════════════════════════════════════════════════
// EMA CHOP FILTER (stricter)
// ═══════════════════════════════════════════════════════════════════════════════

float _emaSpr = math.abs(_e9 - _e21) / _atr
bool _squeezed = _emaSpr < 0.20

// EMA fan: all 3 EMAs must be spreading apart
bool _emaFanBull = _e9 > _e21 and _e21 > _e50 and (_e9 - _e21) > (_e9p - _e21p) * 0.9
bool _emaFanBear = _e9 < _e21 and _e21 < _e50 and (_e21 - _e9) > (_e21p - _e9p) * 0.9

// ═══════════════════════════════════════════════════════════════════════════════
// STRUCTURE
// ═══════════════════════════════════════════════════════════════════════════════

float _pivH = ta.pivothigh(high, _swL, _swL)
float _pivL = ta.pivotlow(low, _swL, _swL)

var float _sh1 = na, var float _sh2 = na
var float _sl1 = na, var float _sl2 = na

if not na(_pivH)
    _sh2 := _sh1
    _sh1 := _pivH
if not na(_pivL)
    _sl2 := _sl1
    _sl1 := _pivL

bool _HH = not na(_sh1) and not na(_sh2) and _sh1 > _sh2
bool _HL = not na(_sl1) and not na(_sl2) and _sl1 > _sl2
bool _LH = not na(_sh1) and not na(_sh2) and _sh1 < _sh2
bool _LL = not na(_sl1) and not na(_sl2) and _sl1 < _sl2

bool _structBull = _HH and _HL
bool _structBear = _LH and _LL

// BOS only — NO CHoCH trades (trend continuation only)
bool _bosUp = _structBull and _c1 > nz(_sh1, _c1) and _c2 <= nz(_sh1, _c2)
bool _bosDn = _structBear and _c1 < nz(_sl1, _c1) and _c2 >= nz(_sl1, _c2)

// ═══════════════════════════════════════════════════════════════════════════════
// ORDER BLOCKS
// ═══════════════════════════════════════════════════════════════════════════════

var float _obBT = na, var float _obBB = na, var int _obBBar = 0
var float _obST = na, var float _obSB = na, var int _obSBar = 0

bool _sBullMv = (_c1 - _o1) > _atr * 1.5 and _c1 > _o1
bool _sBearMv = (_o1 - _c1) > _atr * 1.5 and _c1 < _o1

if _sBullMv and _c2 < _o2
    _obBT := math.max(_o2, _c2)
    _obBB := math.min(_o2, _c2)
    _obBBar := bar_index - 1
if _sBearMv and _c2 > _o2
    _obST := math.max(_o2, _c2)
    _obSB := math.min(_o2, _c2)
    _obSBar := bar_index - 1

bool _nearOBL = not na(_obBT) and _l1 <= _obBT * 1.003 and _c1 > _obBB and (bar_index - _obBBar) < 40
bool _nearOBS = not na(_obST) and _h1 >= _obSB * 0.997 and _c1 < _obST and (bar_index - _obSBar) < 40

if i_showOB and _sBullMv and _c2 < _o2
    box.new(bar_index - 1, _obBT, bar_index + 20, _obBB, bgcolor=color.new(i_lc, 88), border_color=color.new(i_lc, 60))
if i_showOB and _sBearMv and _c2 > _o2
    box.new(bar_index - 1, _obST, bar_index + 20, _obSB, bgcolor=color.new(i_sc, 88), border_color=color.new(i_sc, 60))

// ═══════════════════════════════════════════════════════════════════════════════
// FVG
// ═══════════════════════════════════════════════════════════════════════════════

var float _fvBT = na, var float _fvBB = na, var int _fvBBar = 0
var float _fvST = na, var float _fvSB = na, var int _fvSBar = 0

if _l1 > _h3 and _c2 > _o2
    _fvBT := _l1
    _fvBB := _h3
    _fvBBar := bar_index - 1
if _h1 < _l3 and _c2 < _o2
    _fvST := _l3
    _fvSB := _h1
    _fvSBar := bar_index - 1

bool _inFVGL = not na(_fvBT) and _c1 >= _fvBB and _c1 <= _fvBT and (bar_index - _fvBBar) < 30
bool _inFVGS = not na(_fvST) and _c1 <= _fvST and _c1 >= _fvSB and (bar_index - _fvSBar) < 30

// ═══════════════════════════════════════════════════════════════════════════════
// PREMIUM / DISCOUNT
// ═══════════════════════════════════════════════════════════════════════════════

float _rH = nz(_sh1, _h1)
float _rL = nz(_sl1, _l1)
float _rM = (_rH + _rL) / 2.0
bool _disc   = _c1 < _rM
bool _prem   = _c1 > _rM
bool _dDisc  = _c1 < _rL + (_rH - _rL) * 0.3
bool _dPrem  = _c1 > _rL + (_rH - _rL) * 0.7

// ═══════════════════════════════════════════════════════════════════════════════
// HTF — FULL ALIGNMENT (stricter RSI bands)
// ═══════════════════════════════════════════════════════════════════════════════

f_htf(_tf) =>
    _a = request.security(syminfo.tickerid, _tf, ta.ema(close, 9)[1],  lookahead=barmerge.lookahead_off)
    _b = request.security(syminfo.tickerid, _tf, ta.ema(close, 21)[1], lookahead=barmerge.lookahead_off)
    _d = request.security(syminfo.tickerid, _tf, ta.ema(close, 50)[1], lookahead=barmerge.lookahead_off)
    _p = request.security(syminfo.tickerid, _tf, close[1], lookahead=barmerge.lookahead_off)
    _r = request.security(syminfo.tickerid, _tf, ta.rsi(close, 14)[1], lookahead=barmerge.lookahead_off)
    _bu = _a > _b and _b > _d and _p > _a and _r < 75 and _r > 38
    _be = _a < _b and _b < _d and _p < _a and _r > 25 and _r < 62
    _bu ? 1 : _be ? -1 : 0

int _t15 = f_htf("15")
int _t1h = f_htf("60")
int _t4h = f_htf("240")
int _t1d = f_htf("D")

// Require FULL alignment across multiple HTFs
bool _htfBull = _isLTF ? (_t15 == 1 and _t1h == 1 and _t4h == 1) : (_isMTF ? (_t4h == 1 and _t1d == 1) : (_t1d == 1))
bool _htfBear = _isLTF ? (_t15 == -1 and _t1h == -1 and _t4h == -1) : (_isMTF ? (_t4h == -1 and _t1d == -1) : (_t1d == -1))

// ═══════════════════════════════════════════════════════════════════════════════
// EMA / CANDLE / MOMENTUM
// ═══════════════════════════════════════════════════════════════════════════════

bool _stackBull = _e9 > _e21 and _e21 > _e50
bool _stackBear = _e9 < _e21 and _e21 < _e50
bool _abv200    = _c1 > _e200
bool _blw200    = _c1 < _e200

float _body  = math.abs(_c1 - _o1)
float _rng   = _h1 - _l1
float _body2 = math.abs(_c2 - _o2)

bool _bullC  = _c1 > _o1 and _body > _rng * 0.55
bool _bearC  = _c1 < _o1 and _body > _rng * 0.55
bool _strBull = _bullC and _body > _atr * 0.6
bool _strBear = _bearC and _body > _atr * 0.6

// Strong close: close in upper/lower 30% of range (tighter than v5's 35%)
bool _strongCloseBull = _rng > 0 and (_c1 - _l1) / _rng > 0.70
bool _strongCloseBear = _rng > 0 and (_h1 - _c1) / _rng > 0.70

bool _engulfBull = _c1 > _o1 and _c2 < _o2 and _c1 > _o2 and _o1 < _c2 and _body > _body2
bool _engulfBear = _c1 < _o1 and _c2 > _o2 and _c1 < _o2 and _o1 > _c2 and _body > _body2

// 2-BAR MOMENTUM: last 2 confirmed bars both closed in same direction
bool _2bull = _c1 > _o1 and _c2 > _o2
bool _2bear = _c1 < _o1 and _c2 < _o2

// 3-BAR MOMENTUM: last 3 confirmed bars all closed in same direction (extra strong)
bool _3bull = _2bull and _c3 > close[4]
bool _3bear = _2bear and _c3 < close[4]

float _lwk = math.min(_c1, _o1) - _l1
float _uwk = _h1 - math.max(_c1, _o1)
bool _bWick = _lwk > _body * 1.5 and _c1 > _o1
bool _sWick = _uwk > _body * 1.5 and _c1 < _o1

// Rejection wick: upper wick < 30% of range for bull (clean close)
bool _cleanBull = _rng > 0 and _uwk / _rng < 0.30
bool _cleanBear = _rng > 0 and _lwk / _rng < 0.30

bool _rsiBOK  = _rsi > 45 and _rsi < 63
bool _rsiSOK  = _rsi > 37 and _rsi < 55
bool _rsiMomB = _rsi > _rsiP and _rsi > 50
bool _rsiMomS = _rsi < _rsiP and _rsi < 50

bool _macdBull    = _mH > 0 or _mH > _mHp
bool _macdBear    = _mH < 0 or _mH < _mHp
bool _macdXUp     = _mH > 0 and _mHp <= 0
bool _macdXDn     = _mH < 0 and _mHp >= 0
// MACD line above signal for bull, below for bear
bool _macdLineB   = _mLine > _mSig
bool _macdLineS   = _mLine < _mSig

bool _volOK   = _vR > 1.0
bool _volStr  = _vR > 1.3
bool _volDry  = _vR < 0.5

// Pullbacks
bool _pb9L  = _l1 <= _e9 * 1.002 and _c1 > _e9 and _bullC
bool _pb21L = _l1 <= _e21 * 1.004 and _c1 > _e21 and _bullC
bool _pb50L = _l1 <= _e50 * 1.005 and _c1 > _e50 and _strBull
bool _pb9S  = _h1 >= _e9 * 0.998 and _c1 < _e9 and _bearC
bool _pb21S = _h1 >= _e21 * 0.996 and _c1 < _e21 and _bearC
bool _pb50S = _h1 >= _e50 * 0.995 and _c1 < _e50 and _strBear
bool _pbL   = _pb9L or _pb21L or _pb50L
bool _pbS   = _pb9S or _pb21S or _pb50S

// ═══════════════════════════════════════════════════════════════════════════════
// SESSION (stricter for LTF)
// ═══════════════════════════════════════════════════════════════════════════════

int _hr      = hour(time, "UTC")
bool _lonSess = _hr >= 7 and _hr < 16    // London session
bool _nySess  = _hr >= 13 and _hr < 20   // NY session
bool _olap    = _hr >= 13 and _hr < 16   // London/NY overlap
bool _dead    = _hr >= 21 or _hr < 3
// LTF: only trade during London or NY sessions (no dead zones)
// MTF/HTF: skip dead hours only
bool _sesOK  = _isLTF ? (_lonSess or _nySess) : (not _dead)
float _sesM  = _olap ? 1.2 : (_lonSess or _nySess ? 1.0 : 0.6)

// ═══════════════════════════════════════════════════════════════════════════════
// VOLATILITY
// ═══════════════════════════════════════════════════════════════════════════════

bool _volRngOK  = _vExp > 0.6 and _vExp < 2.5
bool _tooChoppy = _vExp > 2.2

// ═══════════════════════════════════════════════════════════════════════════════
// CONFLUENCE SCORING (re-weighted for higher accuracy)
// ═══════════════════════════════════════════════════════════════════════════════

float _cB = 0.0, float _cS = 0.0

// Structure (0-4) — more weight to confirmed structure
_cB += _structBull ? 2.5 : (_HH or _HL ? 1.0 : 0.0)
_cB += _bosUp      ? 1.5 : 0.0
_cS += _structBear ? 2.5 : (_LH or _LL ? 1.0 : 0.0)
_cS += _bosDn      ? 1.5 : 0.0

// HTF (0-3 / -4) — highest weight, this is the #1 predictor
_cB += _htfBull ? 3.0 : 0.0
_cS += _htfBear ? 3.0 : 0.0
_cB -= _htfBear ? 4.0 : 0.0
_cS -= _htfBull ? 4.0 : 0.0

// ADX (0-2.5)
_cB += _trending and _adxBull ? 1.5 : (_trending ? 0.5 : 0.0)
_cS += _trending and _adxBear ? 1.5 : (_trending ? 0.5 : 0.0)
_cB += _strongTrend and _adxBull ? 0.5 : 0.0
_cS += _strongTrend and _adxBear ? 0.5 : 0.0
_cB += _adxRising and _adxBull ? 0.5 : 0.0
_cS += _adxRising and _adxBear ? 0.5 : 0.0

// OB/FVG (0-3.5)
_cB += _nearOBL ? 2.0 : 0.0
_cB += _inFVGL  ? 1.5 : 0.0
_cS += _nearOBS ? 2.0 : 0.0
_cS += _inFVGS  ? 1.5 : 0.0

// Discount/Premium (0-1.5 / -2.5)
_cB += _dDisc ? 1.5 : (_disc ? 0.8 : 0.0)
_cS += _dPrem ? 1.5 : (_prem ? 0.8 : 0.0)
_cB -= _prem  ? 2.5 : 0.0
_cS -= _disc  ? 2.5 : 0.0

// EMA (0-3)
_cB += _stackBull ? 1.5 : 0.0
_cB += _abv200    ? 0.5 : 0.0
_cB += _emaFanBull ? 1.0 : 0.0
_cS += _stackBear ? 1.5 : 0.0
_cS += _blw200    ? 0.5 : 0.0
_cS += _emaFanBear ? 1.0 : 0.0

// Pullback (0-1.5)
_cB += _pbL ? 1.5 : 0.0
_cS += _pbS ? 1.5 : 0.0

// Candle (0-3.5) — more weight to multi-bar momentum
_cB += _strBull ? 1.0 : (_bullC ? 0.5 : 0.0)
_cB += _engulfBull ? 1.0 : 0.0
_cB += _2bull ? 0.75 : 0.0
_cB += _3bull ? 0.75 : 0.0
_cB += _strongCloseBull and _cleanBull ? 0.5 : 0.0
_cS += _strBear ? 1.0 : (_bearC ? 0.5 : 0.0)
_cS += _engulfBear ? 1.0 : 0.0
_cS += _2bear ? 0.75 : 0.0
_cS += _3bear ? 0.75 : 0.0
_cS += _strongCloseBear and _cleanBear ? 0.5 : 0.0

// RSI (0-1.5 / -3)
_cB += _rsiBOK ? 0.5 : 0.0
_cB += _rsiMomB ? 1.0 : 0.0
_cS += _rsiSOK ? 0.5 : 0.0
_cS += _rsiMomS ? 1.0 : 0.0
_cB -= _rsi > 70 ? 3.0 : (_rsi > 65 ? 1.5 : 0.0)
_cS -= _rsi < 30 ? 3.0 : (_rsi < 35 ? 1.5 : 0.0)

// MACD (0-1.5)
_cB += _macdBull ? 0.5 : 0.0
_cB += _macdXUp  ? 0.5 : 0.0
_cB += _macdLineB ? 0.5 : 0.0
_cS += _macdBear ? 0.5 : 0.0
_cS += _macdXDn  ? 0.5 : 0.0
_cS += _macdLineS ? 0.5 : 0.0

// Volume (0-1 / -2.5)
_cB += _volOK and _bullC ? 0.7 : 0.0
_cB += _volStr and _bullC ? 0.3 : 0.0
_cS += _volOK and _bearC ? 0.7 : 0.0
_cS += _volStr and _bearC ? 0.3 : 0.0
_cB -= _volDry ? 2.5 : 0.0
_cS -= _volDry ? 2.5 : 0.0

// Session multiplier
_cB *= _sesM
_cS *= _sesM

float _th = _confTh / i_sv

// ═══════════════════════════════════════════════════════════════════════════════
// HARD FILTERS (16 checks — ALL must pass, stricter than v5)
// ═══════════════════════════════════════════════════════════════════════════════
// 1. Session OK
// 2. Volatility in range
// 3. Not dry volume
// 4. Bullish/bearish candle
// 5. HTF fully aligned
// 6. No recent CHoCH (trend continuation only)
// 7. Not too choppy
// 8. Full EMA stack
// 9. Above/below 200 EMA
// 10. ADX trending
// 11. ADX direction matches
// 12. Not squeezed
// 13. Volume above average
// 14. RSI not extreme
// 15. Strong close (upper/lower 30%)
// 16. Trigger (pullback OR order block OR FVG OR engulfing OR rejection wick)

bool _noChochRecent = true
var int _lastChoch = 0
if (_structBear and _c1 > nz(_sh1, _c1)) or (_structBull and _c1 < nz(_sl1, _c1))
    _lastChoch := bar_index
_noChochRecent := (bar_index - _lastChoch) >= 25

bool _hB = _sesOK and _volRngOK and not _volDry and _bullC and _htfBull and _noChochRecent and not _tooChoppy and _stackBull and _abv200 and _trending and _adxBull and not _squeezed and _volOK and _rsi < 70 and _rsi > 40 and _strongCloseBull and _cleanBull and _2bull and (_pbL or _nearOBL or _inFVGL or _engulfBull or _bWick)
bool _hS = _sesOK and _volRngOK and not _volDry and _bearC and _htfBear and _noChochRecent and not _tooChoppy and _stackBear and _blw200 and _trending and _adxBear and not _squeezed and _volOK and _rsi > 30 and _rsi < 60 and _strongCloseBear and _cleanBear and _2bear and (_pbS or _nearOBS or _inFVGS or _engulfBear or _sWick)

// ═══════════════════════════════════════════════════════════════════════════════
// RAW SIGNAL
// ═══════════════════════════════════════════════════════════════════════════════

bool _rawL = _hB and _cB >= _th and _cB > _cS
bool _rawS = _hS and _cS >= _th and _cS > _cB

// ═══════════════════════════════════════════════════════════════════════════════
// TRADE STATE
// ═══════════════════════════════════════════════════════════════════════════════

var bool  _inT   = false
var int   _dir   = 0
var float _entry = na
var float _sl    = na
var float _tp    = na
var float _slOrig = na
var bool  _beMoved = false
var int   _tBar  = 0
var int   _tIdx  = -1

// 2-BAR CONFIRMATION: signal fires on bar N, we wait for bar N+1 to also
// close in same direction, then enter at open of bar N+2
var bool  _pendL = false
var bool  _pendS = false
var int   _pendBar = 0
var float _pendConf = 0.0

var int _cdL = 0, var int _cdS2 = 0, var int _cdG = 0
var int _cLoss = 0, var int _fSL = 0

var int _totW  = 0
var int _totL  = 0
var int _totBE = 0
var int _totTE = 0    // time exits
var int _totT  = 0
var int _lSig  = 0

// ═══════════════════════════════════════════════════════════════════════════════
// GATING
// ═══════════════════════════════════════════════════════════════════════════════

bool _conf  = barstate.isconfirmed
bool _gap   = (bar_index - _lSig) >= _minGap
bool _cdLOK = _cdL <= 0 and _cdG <= 0
bool _cdSOK = _cdS2 <= 0 and _cdG <= 0

// ═══════════════════════════════════════════════════════════════════════════════
// 2-BAR CONFIRMATION SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════
// Step 1: Raw signal fires → set pending
// Step 2: Next confirmed bar must ALSO close in signal direction → confirm entry
// This filters out ~30% of fake signals where momentum doesn't follow through

// Set pending on raw signal
if _conf and _rawL and not _inT and _cdLOK and _gap and not _pendL and not _pendS
    _pendL   := true
    _pendS   := false
    _pendBar := bar_index
    _pendConf := _cB

if _conf and _rawS and not _inT and _cdSOK and _gap and not _pendL and not _pendS
    _pendS   := true
    _pendL   := false
    _pendBar := bar_index
    _pendConf := _cS

// Cancel pending if both fire (shouldn't happen due to hard filters but safety)
if _pendL and _pendS
    _pendL := false
    _pendS := false

// Cancel pending if took too long (must confirm next bar)
if _pendL and (bar_index - _pendBar) > 1
    _pendL := false
if _pendS and (bar_index - _pendBar) > 1
    _pendS := false

// Confirm long: pending was set last bar, THIS bar also closed bullish
bool _confirmL = _conf and _pendL and (bar_index - _pendBar) == 1 and _c1 > _o1
// Confirm short: pending was set last bar, THIS bar also closed bearish
bool _confirmS = _conf and _pendS and (bar_index - _pendBar) == 1 and _c1 < _o1

// Clear pending after confirmation check
if (bar_index - _pendBar) >= 1
    _pendL := false
    _pendS := false

// ═══════════════════════════════════════════════════════════════════════════════
// SL/TP — R:R 0.75 DEFAULT
// ═══════════════════════════════════════════════════════════════════════════════
// SL = lowest/highest of recent N bars + padding, min 2.0 ATR
// TP = entry + slDist * R:R (default 0.75)

f_longSLTP() =>
    float _ePx = open
    float _stop = _recentLow - _atr * i_slPad
    // Minimum 2.0 ATR from entry
    float _minS = _ePx - _atr * 2.0
    _stop := math.min(_stop, _minS)
    // Max 3.0 ATR
    _stop := math.max(_stop, _ePx - _atr * 3.0)
    float _dist = _ePx - _stop
    float _take = _ePx + _dist * i_rr
    [_stop, _take, _ePx]

f_shortSLTP() =>
    float _ePx = open
    float _stop = _recentHigh + _atr * i_slPad
    float _minS = _ePx + _atr * 2.0
    _stop := math.max(_stop, _minS)
    _stop := math.min(_stop, _ePx + _atr * 3.0)
    float _dist = _stop - _ePx
    float _take = _ePx - _dist * i_rr
    [_stop, _take, _ePx]

// ═══════════════════════════════════════════════════════════════════════════════
// FILLS
// ═══════════════════════════════════════════════════════════════════════════════

color _tpF = color.new(i_lc, 90)
color _slF = color.new(i_sc, 90)
color _tpB = color.new(i_lc, 55)
color _slB = color.new(i_sc, 55)

// ═══════════════════════════════════════════════════════════════════════════════
// LONG ENTRY (on confirmation)
// ═══════════════════════════════════════════════════════════════════════════════

if _confirmL
    [_stp, _tkp, _fpx] = f_longSLTP()
    float _rrC = (_tkp - _fpx) / math.max(_fpx - _stp, _atr * 0.01)
    if _rrC >= 0.6
        _inT    := true
        _dir    := 1
        _entry  := _fpx
        _sl     := _stp
        _slOrig := _stp
        _tp     := _tkp
        _beMoved := false
        _tBar   := bar_index
        _totT   += 1
        _lSig   := bar_index

        array.push(_aTPB,  box.new(bar_index, _tkp, bar_index + 15, _fpx, bgcolor=_tpF, border_color=_tpB, border_width=1))
        array.push(_aSLB,  box.new(bar_index, _fpx, bar_index + 15, _stp, bgcolor=_slF, border_color=_slB, border_width=1))
        array.push(_aELn,  line.new(bar_index, _fpx, bar_index + 15, _fpx, color=_entryBlue, width=2))
        array.push(_aTPLn, line.new(bar_index, _tkp, bar_index + 15, _tkp, color=_tpGreen, width=2))
        array.push(_aSLLn, line.new(bar_index, _stp, bar_index + 15, _stp, color=_slRed, width=2))
        array.push(_aELb,  label.new(bar_index, low - _atr * 0.5, "LONG", style=label.style_label_up, color=i_lc, textcolor=color.white, size=size.small))
        array.push(_aRLb, label(na))
        array.push(_aBar, bar_index)
        array.push(_aDir, 1)
        array.push(_aAct, true)
        _tIdx := array.size(_aTPB) - 1

// ═══════════════════════════════════════════════════════════════════════════════
// SHORT ENTRY (on confirmation)
// ═══════════════════════════════════════════════════════════════════════════════

if _confirmS
    [_stp, _tkp, _fpx] = f_shortSLTP()
    float _rrC = (_fpx - _tkp) / math.max(_stp - _fpx, _atr * 0.01)
    if _rrC >= 0.6
        _inT    := true
        _dir    := -1
        _entry  := _fpx
        _sl     := _stp
        _slOrig := _stp
        _tp     := _tkp
        _beMoved := false
        _tBar   := bar_index
        _totT   += 1
        _lSig   := bar_index

        array.push(_aSLB,  box.new(bar_index, _stp, bar_index + 15, _fpx, bgcolor=_slF, border_color=_slB, border_width=1))
        array.push(_aTPB,  box.new(bar_index, _fpx, bar_index + 15, _tkp, bgcolor=_tpF, border_color=_tpB, border_width=1))
        array.push(_aELn,  line.new(bar_index, _fpx, bar_index + 15, _fpx, color=_entryBlue, width=2))
        array.push(_aTPLn, line.new(bar_index, _tkp, bar_index + 15, _tkp, color=_tpGreen, width=2))
        array.push(_aSLLn, line.new(bar_index, _stp, bar_index + 15, _stp, color=_slRed, width=2))
        array.push(_aELb,  label.new(bar_index, high + _atr * 0.5, "SHORT", style=label.style_label_down, color=i_sc, textcolor=color.white, size=size.small))
        array.push(_aRLb, label(na))
        array.push(_aBar, bar_index)
        array.push(_aDir, -1)
        array.push(_aAct, true)
        _tIdx := array.size(_aTPB) - 1

// ═══════════════════════════════════════════════════════════════════════════════
// TRADE MANAGEMENT — BREAKEVEN + TRAILING + TIME EXIT + CONSERVATIVE SAME-BAR
// ═══════════════════════════════════════════════════════════════════════════════

if _inT and _tIdx >= 0 and _tIdx < array.size(_aTPB)
    box  _bTP = array.get(_aTPB, _tIdx)
    box  _bSL = array.get(_aSLB, _tIdx)
    line _lE  = array.get(_aELn, _tIdx)
    line _lT  = array.get(_aTPLn, _tIdx)
    line _lS  = array.get(_aSLLn, _tIdx)

    if not na(_bTP)
        box.set_right(_bTP, bar_index + 5)
    if not na(_bSL)
        box.set_right(_bSL, bar_index + 5)
    if not na(_lE)
        line.set_x2(_lE, bar_index + 5)
    if not na(_lT)
        line.set_x2(_lT, bar_index + 5)
    if not na(_lS)
        line.set_x2(_lS, bar_index + 5)

    int _since = bar_index - _tBar

    // ── BREAKEVEN MECHANISM (earlier at 0.3 ATR) ──
    if _dir == 1 and not _beMoved and high >= _entry + _atr * i_beATR
        _sl := _entry
        _beMoved := true
        if not na(_lS)
            line.set_y1(_lS, _entry)
            line.set_y2(_lS, _entry)
            line.set_color(_lS, _beColor)

    if _dir == -1 and not _beMoved and low <= _entry - _atr * i_beATR
        _sl := _entry
        _beMoved := true
        if not na(_lS)
            line.set_y1(_lS, _entry)
            line.set_y2(_lS, _entry)
            line.set_color(_lS, _beColor)

    // ── TRAILING SL after breakeven ──
    // Once breakeven is active, trail SL to lock in small profit
    if _dir == 1 and _beMoved
        float _trailSL = high - _atr * 1.5
        if _trailSL > _sl
            _sl := _trailSL
            if not na(_lS)
                line.set_y1(_lS, _sl)
                line.set_y2(_lS, _sl)

    if _dir == -1 and _beMoved
        float _trailSL = low + _atr * 1.5
        if _trailSL < _sl
            _sl := _trailSL
            if not na(_lS)
                line.set_y1(_lS, _sl)
                line.set_y2(_lS, _sl)

    // ── TIME EXIT: close trade after max bars ──
    if _since >= i_maxBars
        float _exitPx = _dir == 1 ? _c1 : _c1
        bool _inProfit = _dir == 1 ? _c1 > _entry : _c1 < _entry
        string _lbl = _inProfit ? "TE +" : "TE -"
        color  _clr = _inProfit ? _tpGreen : _timeColor
        label.new(bar_index, _dir == 1 ? _c1 + _atr * 0.12 : _c1 - _atr * 0.12, _lbl, style=_dir == 1 ? label.style_label_down : label.style_label_up, color=_clr, textcolor=color.white, size=size.tiny)
        array.set(_aAct, _tIdx, false)
        if _inProfit
            _totW += 1
            _cLoss := 0
        else
            _totTE += 1
        _cdG  := _cdBase
        _inT  := false
        _dir  := 0
        _tIdx := -1

    // ── SAME-BAR CHECK ──
    bool _tpHitL = _dir == 1  and high >= _tp
    bool _slHitL = _dir == 1  and low <= _sl
    bool _tpHitS = _dir == -1 and low <= _tp
    bool _slHitS = _dir == -1 and high >= _sl

    bool _bothL = _tpHitL and _slHitL
    bool _bothS = _tpHitS and _slHitS

    // ─── LONG TP ───
    if _tpHitL and not _bothL
        label.new(bar_index, _tp + _atr * 0.12, "TP", style=label.style_label_down, color=i_tc, textcolor=color.white, size=size.tiny)
        array.set(_aAct, _tIdx, false)
        _totW  += 1
        _cLoss := 0
        _fSL   := math.max(0, _fSL - 1)
        _cdG   := _cdBase
        _inT   := false
        _dir   := 0
        _tIdx  := -1

    // ─── LONG SL or SAME-BAR ───
    else if _slHitL or _bothL
        bool _isBE = _beMoved and _sl >= _entry
        string _lbl = _isBE ? "BE" : "SL"
        color  _clr = _isBE ? _beColor : i_slTag
        label.new(bar_index, _sl - _atr * 0.12, _lbl, style=label.style_label_up, color=_clr, textcolor=color.white, size=size.tiny)
        array.set(_aAct, _tIdx, false)
        if _isBE
            _totBE += 1
        else
            _totL += 1
            _cLoss += 1
            if _since <= 4
                _fSL += 1
                _cdL := _cdLoss + math.min(_fSL * 6, 24)
            else
                _cdL := _cdLoss + math.min(_cLoss * 5, 20)
        _cdG  := _cdBase
        _inT  := false
        _dir  := 0
        _tIdx := -1

    // ─── SHORT TP ───
    else if _tpHitS and not _bothS
        label.new(bar_index, _tp - _atr * 0.12, "TP", style=label.style_label_up, color=i_tc, textcolor=color.white, size=size.tiny)
        array.set(_aAct, _tIdx, false)
        _totW  += 1
        _cLoss := 0
        _fSL   := math.max(0, _fSL - 1)
        _cdG   := _cdBase
        _inT   := false
        _dir   := 0
        _tIdx  := -1

    // ─── SHORT SL or SAME-BAR ───
    else if _slHitS or _bothS
        bool _isBE = _beMoved and _sl <= _entry
        string _lbl = _isBE ? "BE" : "SL"
        color  _clr = _isBE ? _beColor : i_slTag
        label.new(bar_index, _sl + _atr * 0.12, _lbl, style=label.style_label_down, color=_clr, textcolor=color.white, size=size.tiny)
        array.set(_aAct, _tIdx, false)
        if _isBE
            _totBE += 1
        else
            _totL += 1
            _cLoss += 1
            if _since <= 4
                _fSL += 1
                _cdS2 := _cdLoss + math.min(_fSL * 6, 24)
            else
                _cdS2 := _cdLoss + math.min(_cLoss * 5, 20)
        _cdG  := _cdBase
        _inT  := false
        _dir  := 0
        _tIdx := -1

// ═══════════════════════════════════════════════════════════════════════════════
// COOLDOWN DECAY
// ═══════════════════════════════════════════════════════════════════════════════

if _cdG > 0
    _cdG -= 1
if _cdL > 0
    _cdL -= 1
if _cdS2 > 0
    _cdS2 -= 1
if bar_index % 50 == 0 and _fSL > 0
    _fSL -= 1
if bar_index % 100 == 0 and _cLoss > 0 and not _inT
    _cLoss := math.max(0, _cLoss - 1)

// ═══════════════════════════════════════════════════════════════════════════════
// DASHBOARD
// ═══════════════════════════════════════════════════════════════════════════════

color _bulC = #00E676, _berC = #FF5252, _neuC = #9E9E9E
color _bgC = color.new(#1E1E1E, 15), _txC = #FFFFFF

f_sym(_t) => _t == 1 ? "▲" : _t == -1 ? "▼" : "●"
f_clr(_t) => _t == 1 ? _bulC : _t == -1 ? _berC : _neuC

var table _dsh = table.new(position.top_right, 5, 4, bgcolor=_bgC, border_width=1, border_color=color.new(#333333, 50), frame_width=1, frame_color=color.new(#333333, 50))

if i_showDash and barstate.islast
    table.cell(_dsh, 0, 0, "MTF",   text_color=color.new(_txC, 30), text_size=size.tiny, bgcolor=color.new(#2A2A2A, 10))
    table.cell(_dsh, 1, 0, "15m",   text_color=color.new(_txC, 30), text_size=size.tiny, bgcolor=color.new(#2A2A2A, 10))
    table.cell(_dsh, 2, 0, "1H",    text_color=color.new(_txC, 30), text_size=size.tiny, bgcolor=color.new(#2A2A2A, 10))
    table.cell(_dsh, 3, 0, "4H",    text_color=color.new(_txC, 30), text_size=size.tiny, bgcolor=color.new(#2A2A2A, 10))
    table.cell(_dsh, 4, 0, "1D",    text_color=color.new(_txC, 30), text_size=size.tiny, bgcolor=color.new(#2A2A2A, 10))
    table.cell(_dsh, 0, 1, "Trend", text_color=_txC, text_size=size.tiny, bgcolor=_bgC)
    table.cell(_dsh, 1, 1, f_sym(_t15), text_color=f_clr(_t15), text_size=size.small, bgcolor=_bgC)
    table.cell(_dsh, 2, 1, f_sym(_t1h), text_color=f_clr(_t1h), text_size=size.small, bgcolor=_bgC)
    table.cell(_dsh, 3, 1, f_sym(_t4h), text_color=f_clr(_t4h), text_size=size.small, bgcolor=_bgC)
    table.cell(_dsh, 4, 1, f_sym(_t1d), text_color=f_clr(_t1d), text_size=size.small, bgcolor=_bgC)

    table.cell(_dsh, 0, 2, "Struct", text_color=_txC, text_size=size.tiny, bgcolor=_bgC)
    table.cell(_dsh, 1, 2, _structBull ? "BULL" : _structBear ? "BEAR" : "RANGE", text_color=_structBull ? _bulC : _structBear ? _berC : _neuC, text_size=size.tiny, bgcolor=_bgC)
    table.cell(_dsh, 2, 2, _dDisc ? "DEEP DISC" : _disc ? "DISCOUNT" : _dPrem ? "DEEP PREM" : _prem ? "PREMIUM" : "EQUILIB", text_color=_disc ? _bulC : _prem ? _berC : _neuC, text_size=size.tiny, bgcolor=_bgC)
    table.cell(_dsh, 3, 2, "ADX:" + (_strongTrend ? "STRONG" : _trending ? "TREND" : "RANGE"), text_color=_strongTrend ? _bulC : _trending ? #FFC107 : _berC, text_size=size.tiny, bgcolor=_bgC)
    table.cell(_dsh, 4, 2, _adxRising ? "RISING" : "FALLING", text_color=_adxRising ? _bulC : _berC, text_size=size.tiny, bgcolor=_bgC)

    table.cell(_dsh, 0, 3, "HTF", text_color=_txC, text_size=size.tiny, bgcolor=_bgC)
    table.cell(_dsh, 1, 3, _htfBull ? "BULL" : _htfBear ? "BEAR" : "NONE", text_color=_htfBull ? _bulC : _htfBear ? _berC : _neuC, text_size=size.tiny, bgcolor=_bgC)
    table.cell(_dsh, 2, 3, _olap ? "OVERLAP" : (_lonSess or _nySess) ? "ACTIVE" : "OFF-HRS", text_color=_olap ? _bulC : (_lonSess or _nySess) ? #FFC107 : _berC, text_size=size.tiny, bgcolor=_bgC)
    table.cell(_dsh, 3, 3, _pendL ? "PEND L" : _pendS ? "PEND S" : _beMoved ? "BE ON" : _inT ? "IN TRADE" : "READY", text_color=_pendL ? #FFC107 : _pendS ? #FFC107 : _beMoved ? _beColor : _inT ? _bulC : _neuC, text_size=size.tiny, bgcolor=_bgC)
    table.cell(_dsh, 4, 3, "", text_color=_txC, text_size=size.tiny, bgcolor=_bgC)

// ═══════════════════════════════════════════════════════════════════════════════
// STATS — WINS, LOSSES, BREAKEVENS, TIME EXITS, WIN%
// ═══════════════════════════════════════════════════════════════════════════════

var table _st = table.new(position.bottom_right, 2, 7, bgcolor=_bgC, border_width=1, border_color=color.new(#333333, 50), frame_width=1, frame_color=color.new(#333333, 50))

if i_showStats and barstate.islast
    // Win rate: wins / (wins + losses). BEs and time exits (profitable) count as wins above.
    // Time exits (loss) are neutral — not counted as loss.
    int _decided = _totW + _totL
    float _wr = _decided > 0 ? (_totW * 1.0 / _decided) * 100.0 : 0.0
    color _wrC = _wr >= 75 ? _bulC : _wr >= 60 ? #FFC107 : _berC

    table.cell(_st, 0, 0, _isLTF ? "LTF" : _isMTF ? "MTF" : "HTF", text_color=color.new(_txC, 30), text_size=size.tiny, bgcolor=color.new(#2A2A2A, 10))
    table.cell(_st, 1, 0, "v6",     text_color=color.new(_txC, 30), text_size=size.tiny, bgcolor=color.new(#2A2A2A, 10))
    table.cell(_st, 0, 1, "Total",text_color=_txC, text_size=size.tiny, bgcolor=_bgC)
    table.cell(_st, 1, 1, str.tostring(_totT), text_color=_txC, text_size=size.tiny, bgcolor=_bgC)
    table.cell(_st, 0, 2, "Wins", text_color=_bulC, text_size=size.tiny, bgcolor=_bgC)
    table.cell(_st, 1, 2, str.tostring(_totW), text_color=_bulC, text_size=size.tiny, bgcolor=_bgC)
    table.cell(_st, 0, 3, "Losses", text_color=_berC, text_size=size.tiny, bgcolor=_bgC)
    table.cell(_st, 1, 3, str.tostring(_totL), text_color=_berC, text_size=size.tiny, bgcolor=_bgC)
    table.cell(_st, 0, 4, "B/E",  text_color=_beColor, text_size=size.tiny, bgcolor=_bgC)
    table.cell(_st, 1, 4, str.tostring(_totBE), text_color=_beColor, text_size=size.tiny, bgcolor=_bgC)
    table.cell(_st, 0, 5, "Time", text_color=_timeColor, text_size=size.tiny, bgcolor=_bgC)
    table.cell(_st, 1, 5, str.tostring(_totTE), text_color=_timeColor, text_size=size.tiny, bgcolor=_bgC)
    table.cell(_st, 0, 6, "Win%", text_color=_wrC, text_size=size.tiny, bgcolor=_bgC)
    table.cell(_st, 1, 6, str.tostring(_wr, "#.1") + "%", text_color=_wrC, text_size=size.tiny, bgcolor=_bgC)

// ═══════════════════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════════════════

alertcondition(_confirmL, title="Long",  message="LONG — 2-bar confirmed, full confluence")
alertcondition(_confirmS, title="Short", message="SHORT — 2-bar confirmed, full confluence")
